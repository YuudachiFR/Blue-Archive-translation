<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BATraduction</AssemblyName>
    <RootNamespace>BATraduction</RootNamespace>
    <Version>1.0.0</Version>
    <Product>BA Traduction</Product>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\dll\build\XInput1_3.dll" LogicalName="XInput1_3.dll" />
    <EmbeddedResource Include="..\glossaire.md" LogicalName="glossaire.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.58.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
  </ItemGroup>

</Project>
